# AurexAi environment
FLASK_SECRET_KEY=change-me-to-random-32-chars
DATABASE_URL=sqlite:///aurexai.db

# Default admin (created on first run if not exists)
ADMIN_EMAIL=owner@aurexai.uz
ADMIN_PASSWORD=BelizardjonAstro
ADMIN_TELEGRAM=aurex_admin

# Site
SITE_NAME=AurexAi
SITE_LOGO=/static/img/logo.svg

# Optional: default OpenRouter key for first boot
OPENROUTER_API_KEY=

# Public domain (for production)
PUBLIC_DOMAIN=aurexai.uz

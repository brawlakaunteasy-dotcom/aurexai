[Unit]
Description=AurexAi - AI platform
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/aurexai
EnvironmentFile=/opt/aurexai/.env
ExecStart=/opt/aurexai/.venv/bin/gunicorn -w 4 -k gthread --threads 8 -b 127.0.0.1:8000 --timeout 600 app:app
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
